# Cache/CDN (Cloudflare). Brotli e Gzip são negociados automaticamente pela
# borda para todo conteúdo texto (HTML, JS, CSS, JSON, SVG) — não é necessário
# pré-comprimir os arquivos aqui.

# Bundles com hash no nome: imutáveis
/_build/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes self-hosted (nome estável, conteúdo estável)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Ícones/imagens estáticas do app
/icons/*
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000

# Manifest e service worker precisam revalidar para não travar updates do PWA
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache

# HTML: sempre revalida (SSR), mas pode ser servido do cache da borda enquanto revalida
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
